# Caddy + Coraza for the WAF comparison (docs/WAF-BENCH-PLAN.md). Must differ
# from Caddyfile by `order coraza_waf first` and the coraza_waf block only.
# Same pool shape as nginx.conf and prx.toml: two round-robin
# upstreams, upstream keep-alive, no retries, logging off.
{
	order coraza_waf first
	admin off
	auto_https off
	log {
		level ERROR
	}
}

:8080 {
	coraza_waf {
		directives `
			Include /bench/waf/modsec.conf
		`
	}
	respond /healthz "ok" 200
	reverse_proxy backend1:8000 backend2:8000 {
		lb_policy round_robin
		lb_retries 0
		transport http {
			keepalive 60s
			keepalive_idle_conns 256
			# Explicit so the pool matches nginx's `keepalive 256`. Measured: no
			# effect at 64 connections (23.1k vs 23.7k rps), so it is parity, not a fix.
			keepalive_idle_conns_per_host 256
			dial_timeout 1s
			response_header_timeout 5s
		}
	}
}
