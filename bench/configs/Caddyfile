# Caddy reference config for the WAF comparison: the WAF-off twin of
# Caddyfile.coraza. Same pool shape as nginx.conf and prx.toml: two round-robin
# upstreams, upstream keep-alive, no retries, logging off.
{
	admin off
	auto_https off
	log {
		level ERROR
	}
}

:8080 {
	respond /healthz "ok" 200
	reverse_proxy backend1:8000 backend2:8000 {
		lb_policy round_robin
		lb_retries 0
		transport http {
			keepalive 60s
			keepalive_idle_conns 256
			# Without this Go's transport keeps 2 idle conns per upstream and
			# redials the rest on every request; nginx pools 256 per worker.
			keepalive_idle_conns_per_host 256
			dial_timeout 1s
			response_header_timeout 5s
		}
	}
}
