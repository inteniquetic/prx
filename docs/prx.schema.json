{
  "$defs": {
    "AcmeConfig": {
      "description": "Automatic certificates over ACME (Let's Encrypt and compatible servers).",
      "properties": {
        "ca_root_path": {
          "default": null,
          "description": "PEM file with the CA that signs the ACME server's own TLS certificate.\nNeeded for a private ACME server (step-ca, Pebble); public providers\nare trusted through the system roots.",
          "type": [
            "string",
            "null"
          ]
        },
        "directory_url": {
          "default": "https://acme-staging-v02.api.letsencrypt.org/directory",
          "type": "string"
        },
        "domains": {
          "default": [],
          "description": "Domains to request a certificate for.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "email": {
          "default": [],
          "description": "Contact addresses registered with the ACME account.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "renew_before_days": {
          "default": 30,
          "description": "Renew this many days before expiry.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "storage_dir": {
          "default": "./acme",
          "description": "Where the account key and issued certificate are kept.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "AdminAuth": {
      "description": "How the admin API checks a caller.\n\n`none` is only legal on a loopback listener: a control plane that can\nrewrite the proxy's config must not be reachable without a credential.",
      "enum": [
        "none",
        "token",
        "basic"
      ],
      "type": "string"
    },
    "AdminConfig": {
      "description": "The `[admin]` block.\n\nThe credential itself never lives here. `token_file` and `basic_file`\npoint at a file (or, when unset, the `PRX_ADMIN_TOKEN` / `PRX_ADMIN_BASIC`\nenvironment variables), so a config that is shown, diffed or committed\ncannot carry the secret.",
      "properties": {
        "allow_origins": {
          "default": [],
          "description": "Origins allowed to call the API from another site. Empty means\nsame-origin only; `*` is never valid.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "auth": {
          "$ref": "#/$defs/AdminAuth",
          "default": "none"
        },
        "basic_file": {
          "default": null,
          "description": "Path to a file holding `user:password`, one line. Ignored unless\n`auth` is `basic`.",
          "type": [
            "string",
            "null"
          ]
        },
        "listen": {
          "default": "127.0.0.1:9091",
          "type": "string"
        },
        "read_only": {
          "default": false,
          "description": "Serve the API for reading and refuse every change.",
          "type": "boolean"
        },
        "token_file": {
          "default": null,
          "description": "Path to a file holding the bearer token, one line. Ignored unless\n`auth` is `token`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CacheConfig": {
      "description": "Short-lived response cache for a route.\n\nEven a one-second TTL turns a burst of identical requests into a single\nupstream fetch, which is where most of the benefit comes from.",
      "properties": {
        "add_status_header": {
          "default": true,
          "description": "Add an `X-Cache: HIT|MISS` header to responses.",
          "type": "boolean"
        },
        "cache_status_codes": {
          "default": [
            200,
            203,
            300,
            301,
            404
          ],
          "description": "Status codes worth storing.",
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "coalesce_wait_ms": {
          "default": 2000,
          "description": "How long a coalesced request waits for the in-flight fetch before going\nupstream itself.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "key_query": {
          "default": true,
          "description": "Include the query string in the cache key.",
          "type": "boolean"
        },
        "max_body_bytes": {
          "default": 262144,
          "description": "Responses larger than this are streamed through without being stored.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_bytes": {
          "default": 134217728,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_entries": {
          "default": 10000,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "ttl_ms": {
          "default": 2000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "vary_headers": {
          "default": [
            "accept-encoding"
          ],
          "description": "Request headers whose values take part in the cache key, so responses\nthat differ by them are not mixed up.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "CircuitBreakerConfig": {
      "properties": {
        "consecutive_failures": {
          "default": 3,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "open_ms": {
          "default": 30000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "CompressionConfig": {
      "description": "Response compression.\n\nprx uses pingora's streaming compressor, so a large response is compressed\nas it flows through rather than being buffered first.",
      "properties": {
        "decompress_upstream": {
          "default": false,
          "description": "Decompress an already-compressed upstream response when the client\ncannot accept that encoding. Off by default: it is expensive and rarely\nwhat an operator wants.",
          "type": "boolean"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "level": {
          "default": 4,
          "description": "Compression level. Higher costs CPU for a smaller body; 3-6 is the\nusual range for a proxy that compresses on the fly.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ConcurrencyLimitConfig": {
      "description": "Caps how many requests a route may have in flight at once.",
      "properties": {
        "max_concurrent": {
          "default": 0,
          "description": "`0` means unlimited.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "response_status": {
          "default": 503,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "HeaderRules": {
      "description": "Header rules applied to a request or a response.\n\n`set` replaces any existing value, `add` appends another value, and\n`remove` drops the header. They are applied in that order, so a rule set\ncan normalize a header and then append to it.",
      "properties": {
        "add": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "remove": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "set": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        }
      },
      "type": "object"
    },
    "HeadersConfig": {
      "description": "Header rules that apply to every route, applied before the route's own.",
      "properties": {
        "request": {
          "$ref": "#/$defs/HeaderRules",
          "default": {
            "add": {},
            "remove": [],
            "set": {}
          }
        },
        "response": {
          "$ref": "#/$defs/HeaderRules",
          "default": {
            "add": {},
            "remove": [],
            "set": {}
          }
        }
      },
      "type": "object"
    },
    "HealthCheckConfig": {
      "description": "Background probing of a service's upstreams.\n\nPassive detection (the circuit breaker) only removes an upstream after real\nrequests have already failed, so users see the errors. An active probe finds\nthe same failure before a request does, and proves an upstream is healthy\nagain before sending traffic back to it.",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "expected_status": {
          "default": [
            200
          ],
          "description": "Response codes that count as healthy for `kind = \"http\"`.",
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "healthy_threshold": {
          "default": 2,
          "description": "Consecutive successes before a down upstream is used again.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "interval_ms": {
          "default": 2000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/HealthCheckKind",
          "default": "tcp"
        },
        "path": {
          "default": "/healthz",
          "description": "Request path for `kind = \"http\"`.",
          "type": "string"
        },
        "timeout_ms": {
          "default": 1000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unhealthy_threshold": {
          "default": 3,
          "description": "Consecutive failures before an upstream is taken out.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "HealthCheckKind": {
      "oneOf": [
        {
          "const": "tcp",
          "description": "Open a TCP connection and close it again.",
          "type": "string"
        },
        {
          "const": "http",
          "description": "Send a GET and check the status code.",
          "type": "string"
        }
      ]
    },
    "LbStrategy": {
      "oneOf": [
        {
          "enum": [
            "round_robin",
            "random",
            "hash"
          ],
          "type": "string"
        },
        {
          "const": "least_conn",
          "description": "Send the request to whichever of two random upstreams has fewer\nrequests in flight. Power of two choices avoids scanning every\nupstream while getting most of the benefit of true least-connections.",
          "type": "string"
        },
        {
          "const": "p2c_ewma",
          "description": "Like `least_conn`, but weighted by a moving average of each upstream's\nlatency, so a slow-but-accepting upstream is avoided too.",
          "type": "string"
        }
      ]
    },
    "ObservabilityConfig": {
      "properties": {
        "access_log": {
          "default": true,
          "type": "boolean"
        },
        "log_level": {
          "default": "info",
          "type": "string"
        },
        "prometheus_listen": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PluginConfig": {
      "description": "One `[[plugin]]` block.\n\n`config` is left as a raw TOML value because what belongs in it is decided\nby `kind`: the registry checks it, not this struct. Keeping it opaque here\nis what stops every new plugin from having to add a field to the core\nconfig type.",
      "properties": {
        "config": {
          "default": {}
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "type": "object"
    },
    "RateLimitConfig": {
      "description": "Per-route rate limiting.\n\nCheap enough to leave on: one hash and a short lock on a sharded bucket per\nrequest, with a hard cap on how many keys are tracked so a flood of unique\nkeys cannot grow memory without bound.",
      "properties": {
        "burst": {
          "default": 0,
          "description": "How many requests may arrive at once before the sustained rate applies.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "entry_ttl_ms": {
          "default": 60000,
          "description": "Keys idle for this long may be forgotten.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "key": {
          "default": "client_ip",
          "description": "What to count per: `client_ip`, `route`, or `header:<Name>`.",
          "type": "string"
        },
        "max_entries": {
          "default": 100000,
          "description": "Upper bound on tracked keys.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "requests_per_second": {
          "default": 100,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "response_status": {
          "default": 429,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "retry_after": {
          "default": true,
          "description": "Send a `Retry-After` header with the rejection.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "RouteConfig": {
      "properties": {
        "cache": {
          "$ref": "#/$defs/CacheConfig",
          "default": {
            "add_status_header": true,
            "cache_status_codes": [
              200,
              203,
              300,
              301,
              404
            ],
            "coalesce_wait_ms": 2000,
            "enabled": false,
            "key_query": true,
            "max_body_bytes": 262144,
            "max_bytes": 134217728,
            "max_entries": 10000,
            "ttl_ms": 2000,
            "vary_headers": [
              "accept-encoding"
            ]
          }
        },
        "concurrency_limit": {
          "$ref": "#/$defs/ConcurrencyLimitConfig",
          "default": {
            "max_concurrent": 0,
            "response_status": 503
          }
        },
        "enabled": {
          "default": true,
          "description": "A disabled route stays in the file but is left out of the route index,\nso it never matches — the way to park a route without losing how it was\nconfigured.",
          "type": "boolean"
        },
        "host": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "is_default": {
          "default": false,
          "type": "boolean"
        },
        "methods": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "default": "default",
          "type": "string"
        },
        "path_prefix": {
          "default": "/",
          "type": "string"
        },
        "plugins": {
          "default": [],
          "description": "Plugins to run for this route, in this order (T501). Names refer to\n`[[plugin]]` blocks.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rate_limit": {
          "$ref": "#/$defs/RateLimitConfig",
          "default": {
            "burst": 0,
            "enabled": false,
            "entry_ttl_ms": 60000,
            "key": "client_ip",
            "max_entries": 100000,
            "requests_per_second": 100,
            "response_status": 429,
            "retry_after": true
          }
        },
        "request_headers": {
          "$ref": "#/$defs/HeaderRules",
          "default": {
            "add": {},
            "remove": [],
            "set": {}
          }
        },
        "response_headers": {
          "$ref": "#/$defs/HeaderRules",
          "default": {
            "add": {},
            "remove": [],
            "set": {}
          }
        },
        "service": {
          "type": "string"
        }
      },
      "required": [
        "service"
      ],
      "type": "object"
    },
    "ServerConfig": {
      "properties": {
        "config_reload_debounce_ms": {
          "default": 250,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "grace_period_seconds": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "graceful_shutdown_timeout_seconds": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "h2c": {
          "default": true,
          "description": "Accept HTTP/2 over cleartext on the plain listeners. prx peeks for the\nh2 preface and falls back to HTTP/1.1, so leaving this on is safe and\nis what gRPC clients that do not use TLS need.",
          "type": "boolean"
        },
        "health_path": {
          "default": "/healthz",
          "type": "string"
        },
        "listen": {
          "default": [
            "0.0.0.0:8080"
          ],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ready_path": {
          "default": "/readyz",
          "type": "string"
        },
        "threads": {
          "default": null,
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "tls": {
          "anyOf": [
            {
              "$ref": "#/$defs/TlsConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "ServiceConfig": {
      "properties": {
        "circuit_breaker": {
          "$ref": "#/$defs/CircuitBreakerConfig",
          "default": {
            "consecutive_failures": 3,
            "enabled": false,
            "open_ms": 30000
          }
        },
        "health_check": {
          "$ref": "#/$defs/HealthCheckConfig",
          "default": {
            "enabled": false,
            "expected_status": [
              200
            ],
            "healthy_threshold": 2,
            "interval_ms": 2000,
            "kind": "tcp",
            "path": "/healthz",
            "timeout_ms": 1000,
            "unhealthy_threshold": 3
          },
          "description": "Probe upstreams in the background instead of waiting for a real request\nto discover that one is down."
        },
        "lb": {
          "$ref": "#/$defs/LbStrategy",
          "default": "round_robin"
        },
        "max_retries": {
          "default": 0,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "default": "default",
          "type": "string"
        },
        "request_timeout_ms": {
          "default": 0,
          "description": "Total time budget for a request including every retry. `0` disables it.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "retry_backoff_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "retry_budget_min_per_window": {
          "default": 10,
          "description": "Requests below this count per window may always retry, so a service\nthat is idle or just started is not locked out by its own budget.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "retry_budget_ratio": {
          "default": 0.2,
          "description": "Fraction of recent successful requests that may be spent on retries.\n`0.0` disables the budget (retries are then limited only by\n`max_retries`). Keeps a failing upstream from being hammered by the\nretries of every in-flight request at once.",
          "format": "double",
          "type": "number"
        },
        "retry_budget_window_ms": {
          "default": 10000,
          "description": "Window the retry budget is measured over.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "retry_idempotent_only": {
          "default": true,
          "description": "Only retry requests whose method is idempotent once the request may\nalready have reached the upstream. Connect failures are always\nretriable: nothing was sent yet.",
          "type": "boolean"
        },
        "sticky": {
          "$ref": "#/$defs/StickyConfig",
          "default": {
            "enabled": false,
            "mode": "cookie",
            "name": "prx_upstream",
            "ttl_s": 3600
          },
          "description": "Keep a client on the same upstream across requests."
        },
        "upstream": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UpstreamConfig"
          },
          "type": "array"
        },
        "upstream_h2": {
          "$ref": "#/$defs/UpstreamH2",
          "default": "never",
          "description": "Which HTTP version to speak to the upstreams of this service."
        }
      },
      "type": "object"
    },
    "StickyConfig": {
      "description": "Session affinity: keep a client on the upstream it used last.\n\n`cookie` is the only mode that survives a client changing IP, and it is the\nonly one that pins exactly; `client_ip` and `header` hash the key onto the\nupstream ring, so adding or removing an upstream reshuffles some clients.\nEvery mode falls back to normal load balancing when the chosen upstream is\nunavailable, so affinity never costs availability.",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/StickyMode",
          "default": "cookie"
        },
        "name": {
          "default": "prx_upstream",
          "description": "Cookie or header name, depending on the mode.",
          "type": "string"
        },
        "ttl_s": {
          "default": 3600,
          "description": "Lifetime of the cookie in `cookie` mode.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "StickyMode": {
      "oneOf": [
        {
          "const": "cookie",
          "description": "prx sets a cookie naming the upstream and honors it on later requests.",
          "type": "string"
        },
        {
          "const": "client_ip",
          "description": "Hash the client address.",
          "type": "string"
        },
        {
          "const": "header",
          "description": "Hash the value of a request header.",
          "type": "string"
        }
      ]
    },
    "TlsCertConfig": {
      "description": "One certificate and the domains it answers for.",
      "properties": {
        "cert_path": {
          "type": "string"
        },
        "domains": {
          "default": [],
          "description": "Domains this certificate serves. `*.example.com` also covers\n`example.com`. Left empty, the names are read from the certificate\nitself.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "is_default": {
          "default": false,
          "description": "Used for clients that send no SNI, or a name no certificate covers.",
          "type": "boolean"
        },
        "key_path": {
          "type": "string"
        }
      },
      "required": [
        "cert_path",
        "key_path"
      ],
      "type": "object"
    },
    "TlsConfig": {
      "properties": {
        "acme": {
          "$ref": "#/$defs/AcmeConfig",
          "default": {
            "ca_root_path": null,
            "directory_url": "https://acme-staging-v02.api.letsencrypt.org/directory",
            "domains": [],
            "email": [],
            "enabled": false,
            "renew_before_days": 30,
            "storage_dir": "./acme"
          },
          "description": "Obtain and renew certificates automatically."
        },
        "cert": {
          "default": [],
          "description": "Certificates to choose from by SNI.",
          "items": {
            "$ref": "#/$defs/TlsCertConfig"
          },
          "type": "array"
        },
        "cert_path": {
          "default": null,
          "description": "Single-certificate form, kept so existing configs keep working. Prefer\n`[[server.tls.cert]]`, which supports more than one domain.",
          "type": [
            "string",
            "null"
          ]
        },
        "enable_h2": {
          "default": true,
          "type": "boolean"
        },
        "key_path": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "listen": {
          "type": "string"
        }
      },
      "required": [
        "listen"
      ],
      "type": "object"
    },
    "UpstreamConfig": {
      "properties": {
        "addr": {
          "type": "string"
        },
        "connect_timeout_ms": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "enabled": {
          "default": true,
          "description": "`false` drains the upstream: it stays in the config, keeps being probed,\nand is left out of the selection ring so it takes no traffic.\n\nThis cannot be expressed as `weight = 0` — the balancer clamps weights to\nat least 1, so a zero-weight upstream would quietly keep serving.",
          "type": "boolean"
        },
        "idle_timeout_ms": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "read_timeout_ms": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sni": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "tls": {
          "default": false,
          "type": "boolean"
        },
        "total_connect_timeout_ms": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "verify_cert": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "verify_hostname": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "weight": {
          "default": 1,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "write_timeout_ms": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "addr"
      ],
      "type": "object"
    },
    "UpstreamH2": {
      "description": "How prx talks to a service's upstreams.\n\ngRPC needs `always`: it requires end-to-end HTTP/2 because it carries its\nstatus in trailers, which HTTP/1.1 cannot express.",
      "oneOf": [
        {
          "const": "never",
          "description": "HTTP/1.1 only.",
          "type": "string"
        },
        {
          "const": "always",
          "description": "HTTP/2 only. Over TLS this is negotiated with ALPN; over cleartext prx\ntrusts that the upstream speaks h2c.",
          "type": "string"
        },
        {
          "const": "auto",
          "description": "Prefer HTTP/2, fall back to HTTP/1.1. Over cleartext there is no ALPN to\nnegotiate with, so this behaves like `never`.",
          "type": "string"
        }
      ]
    },
    "WafConfig": {
      "description": "The `[waf]` block. Absent means no rules, so the WAF does nothing.",
      "properties": {
        "inbound_anomaly_threshold": {
          "description": "Summed anomaly score at which a request is blocked. Must be positive.\nUnset means 5.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "paranoia_level": {
          "description": "CRS paranoia level, 1 to 4. Only rules at or below this level count\ntoward blocking. Unset means 1. Kept as `i64` so that out-of-range\nvalues reach `check` as a `ConfigIssue` instead of a parse error.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "rules_file": {
          "description": "A SecLang rules file. A relative path resolves against the directory\nof the config file.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
