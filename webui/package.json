{
  "name": "prx-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/bundle-budget.mjs",
    "build:only": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && node scripts/contrast-check.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "size": "node scripts/bundle-budget.mjs",
    "smoke": "node scripts/smoke.mjs",
    "contrast": "node scripts/contrast-check.mjs --verbose",
    "styleguide": "vite --open /?styleguide",
    "styleguide:check": "node scripts/styleguide-check.mjs",
    "shell:check": "node scripts/shell-check.mjs",
    "routes:check": "node scripts/routes-check.mjs",
    "services:check": "node scripts/services-check.mjs",
    "dashboard:check": "node scripts/dashboard-check.mjs",
    "diff:check": "node scripts/diff-check.mjs",
    "config:check": "node scripts/config-check.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@lucide/svelte": "^1.47.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.17.23",
    "autoprefixer": "^10.4.21",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.2",
    "vite": "^7.3.6"
  }
}
